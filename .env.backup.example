# Copy this file to .env.backup and paste the Railway Postgres public URL below.
# Find it in Railway dashboard: Postgres service > Variables > DATABASE_PUBLIC_URL
# (host should be something like viaduct.proxy.rlwy.net, NOT *.railway.internal)
#
# .env.backup is gitignored. Never commit the real URL.

DATABASE_URL=postgresql://postgres:PASSWORD@viaduct.proxy.rlwy.net:PORT/railway
